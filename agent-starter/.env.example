# --- LLM provider: "ollama" (default) or "together" ---
LLM_PROVIDER=ollama

# --- Together AI (only when LLM_PROVIDER=together) ---
# Put the real key in your environment / Railway variables, never in a committed file.
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# --- LLM (Ollama) ---
# Local development. In production point this at a remotely reachable Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120

# --- Embeddings / vector store ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./data/chroma
DOCUMENTS_DIRECTORY=./documents

# --- Retrieval ---
TOP_K=5
# Chunks with a cosine distance above this are ignored (lower = stricter).
MAX_DISTANCE=0.9
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Build the index at startup when it is empty.
INGEST_ON_STARTUP=true
MAX_MESSAGE_CHARS=2000

# --- Server ---
LOG_LEVEL=INFO
PORT=8000
